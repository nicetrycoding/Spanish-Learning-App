# ============================================================================
# Spanish Learning Platform — Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` with real secrets.
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spanish_app"

# --- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
# Public URL of the app (used for callback URLs).
NEXTAUTH_URL="http://localhost:3000"

# --- AI provider -------------------------------------------------------------
# The app runs a provider-agnostic AIService (see lib/ai/service.ts).
# Without a key, deterministic rule-based fallbacks power the AI-touched
# features so the app remains fully usable in development/demo mode.
# Currently supported provider: "gemini". Get a key at https://aistudio.google.com/apikey
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
